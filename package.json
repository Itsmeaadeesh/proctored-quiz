{
  "name": "rha-proctored-quiz",
  "version": "1.0.0",
  "private": true,
  "description": "Proctored Quiz Application with Red Hat Theme for RHA DAY 26 at GGITS",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "seed": "npm --prefix server run seed",
    "start": "node server/dist/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.4.5"
  },
  "keywords": ["redhat", "proctored-quiz", "ggits", "anti-cheating", "rha-day-26", "react", "supabase"]
}
